{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

  "logo": {
    "type": "small",
    "padding": {
      "right": 2,
    },
  },

  "display": {
    "separator": "  ",
    "color": {
      "keys": "cyan",
    },
  },

  "modules": [
    {
      "type": "os",
      "key": "os",
    },
    {
      "type": "host",
      "key": "host",
    },
    {
      "type": "kernel",
      "key": "kernel",
      "format": "{2}",
    },
    {
      "type": "uptime",
      "key": "uptime",
      "shorthand": "tiny",
    },
    {
      "type": "memory",
      "key": "memory",
      "format": "{used} / {total}",
    },
    {
      "type": "disk",
      "key": "disk",
      // Shows used/total for /. Add more paths: "folders": "/:/home"
      "folders": "/",
    },
    {
      "type": "editor",
      "key": "editor",
    },
    "break",
    {
      "type": "colors",
      "paddingLeft": 1,
      "symbol": "block",
    },
  ],
}
